+// BananaOS two-panel layout (SDL_BANANA_PANELS=stack: one 1024x1536 window, top panel = y 0..767).
+// PAPERBOAT_SCREENS=single|dual|swap. Everything is placed through ImGui windows.
+#pragma once
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+
+namespace BananaPanels {
+struct PanelRect {
+    float x, y, w, h;
+};
+// One panel's size in pixels. The launcher sets PAPERBOAT_PANEL_W/H from the display's real mode (the RG DS Plus has
+// 1024x768 panels, other models differ); without them 1024x768.
+inline float PanelEnv(const char* name, float def) {
+    const char* e = std::getenv(name);
+    float v = e ? (float)std::atof(e) : 0.0f;
+    return v >= 160.0f && v <= 4096.0f ? v : def;
+}
+inline const float PanelW = PanelEnv("PAPERBOAT_PANEL_W", 1024.0f);
+inline const float PanelH = PanelEnv("PAPERBOAT_PANEL_H", 768.0f);
+
+inline int Mode() {
+    static const int m = [] {
+        const char* e = std::getenv("PAPERBOAT_SCREENS");
+        if (!e) return 0;
+        if (!std::strcmp(e, "dual")) return 1;
+        if (!std::strcmp(e, "swap")) return 2;
+        return 0;
+    }();
+    return m;
+}
+inline bool Active() { return Mode() != 0; }
+inline PanelRect Game() { return { 0, Mode() == 2 ? PanelH : 0, PanelW, PanelH }; }
+inline PanelRect Second() { return { 0, Mode() == 2 ? 0 : PanelH, PanelW, PanelH }; }
+
+// The game side sets this to draw its own content in the "Second Screen" window (called inside ImGui::Begin).
+inline std::function<void(const PanelRect&)> SecondScreenDraw;
+} // namespace BananaPanels
