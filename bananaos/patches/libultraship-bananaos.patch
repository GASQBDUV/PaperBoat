+#include <sys/ioctl.h>
+#include <linux/input.h>
+#include <cstdio>
+
+#include <unistd.h>
+#include <vector>
+
+extern "C" void glReadPixels(int x, int y, int w, int h, unsigned format, unsigned type, void* data);
+
+static void BananaShot() {
+    if (access("/run/banana/paperboat-shot", F_OK) != 0) return;
+    unlink("/run/banana/paperboat-shot");
+    const int w = (int)BananaPanels::PanelW, h = (int)BananaPanels::PanelH * 2;
+    std::vector<unsigned char> px((size_t)w * h * 4);
+    glReadPixels(0, 0, w, h, 0x1908 /*GL_RGBA*/, 0x1401 /*GL_UNSIGNED_BYTE*/, px.data());
+    char path[96];
+    for (int n = 0; n < 1000; n++) {
+        snprintf(path, sizeof(path), "/data/screenshots/paperboat-panels-%03d.ppm", n);
+        if (access(path, F_OK) != 0) break;
+    }
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    fprintf(f, "P6\n%d %d\n255\n", w, h);
+    for (int y = h - 1; y >= 0; y--) { // GL rows are bottom-up
+        for (int x = 0; x < w; x++) fwrite(&px[((size_t)y * w + x) * 4], 1, 3, f);
+    }
+    fclose(f);
+}
+
 namespace Ship {
+
+static void BananaPollTouch(ImGuiIO& io) {
+    static int fd = -2;
+    static int x = 0, y = 0;
+    static bool down = false;
+    static float maxX = 0, maxY = 0; // the touch screen's range, scaled to the panel's pixels
+    if (fd == -2) {
+        fd = -1;
+        for (int i = 0; i < 16 && fd < 0; i++) {
+            char path[32], name[64] = {};
+            snprintf(path, sizeof(path), "/dev/input/event%d", i);
+            int f = open(path, O_RDONLY | O_NONBLOCK);
+            if (f < 0) continue;
+            ioctl(f, EVIOCGNAME(sizeof(name) - 1), name);
+            if (strstr(name, "Touch") || strstr(name, "touch")) {
+                fd = f;
+                struct input_absinfo ax = {}, ay = {};
+                if (ioctl(f, EVIOCGABS(ABS_MT_POSITION_X), &ax) == 0 && ax.maximum > 0) maxX = (float)ax.maximum + 1;
+                if (ioctl(f, EVIOCGABS(ABS_MT_POSITION_Y), &ay) == 0 && ay.maximum > 0) maxY = (float)ay.maximum + 1;
+            } else close(f);
+        }
+    }
+    if (fd < 0) return;
+    struct input_event ev;
+    while (read(fd, &ev, sizeof(ev)) == (ssize_t)sizeof(ev)) {
+        if (ev.type == EV_ABS) {
+            if (ev.code == ABS_MT_POSITION_X || ev.code == ABS_X) x = ev.value;
+            else if (ev.code == ABS_MT_POSITION_Y || ev.code == ABS_Y) y = ev.value;
+        } else if (ev.type == EV_KEY && ev.code == BTN_TOUCH) {
+            down = ev.value != 0;
+        } else if (ev.type == EV_SYN) {
+            io.AddMousePosEvent(maxX > 0 ? x * BananaPanels::PanelW / maxX : (float)x,
+                                (maxY > 0 ? y * BananaPanels::PanelH / maxY : (float)y) + BananaPanels::PanelH);
+            io.AddMouseButtonEvent(0, down);
+        }
+    }
+}
